+class _EuropeanUnionFlagPainter extends CustomPainter {
+  const _EuropeanUnionFlagPainter();
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    canvas.drawRect(Offset.zero & size, Paint()..color = const Color(0xFF003399));
+    final center = size.center(Offset.zero);
+    final radius = size.shortestSide * 0.29;
+    final star = Paint()..color = const Color(0xFFFFCC00);
+    for (var index = 0; index < 12; index++) {
+      final angle = (index * 30 - 90) * 3.141592653589793 / 180;
+      canvas.drawCircle(
+        center + Offset(radius * math.cos(angle), radius * math.sin(angle)),
+        size.shortestSide * 0.035,
+        star,
+      );
+    }
+  }
+
+  @override
+  bool shouldRepaint(covariant _EuropeanUnionFlagPainter oldDelegate) => false;
+}
