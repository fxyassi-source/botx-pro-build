+      ..addAll(bots);
+    _openPositions
+      ..clear()
+      ..addAll(openPositions);
+    _closedTrades
+      ..clear()
+      ..addAll(closedTrades);
+    _prices
+      ..clear()
+      ..addAll(prices);
+  }
