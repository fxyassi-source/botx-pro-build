+  void _clearRuntime() {
+    _initialBalance = 0;
+    _balance = 0;
+    _currency = 'USD';
+    _leverage = 100;
+    _tick = 0;
+    _bots.clear();
+    _openPositions.clear();
+    _closedTrades.clear();
+    _prices.clear();
   }
 
