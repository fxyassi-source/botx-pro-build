+    expect((restored['account'] as Map)['balance'], 9750.0);
+    expect((restored['account'] as Map)['leverage'], 50.0);
+    expect(restored['bots'], isEmpty);
+    expect(restored['openOrders'], isEmpty);
+    final preferences = await SharedPreferences.getInstance();
+    expect(preferences.containsKey('botx.localDemo.snapshot.v1'), isFalse);
+    await engine.flushForTest();
+    engine.dispose();
+  });
