+
+  void _restoreSnapshot(String encoded) {
+    final decoded = jsonDecode(encoded);
+    if (decoded is! Map) throw const FormatException('Demo snapshot must be an object.');
+    final snapshot = Map<String, dynamic>.from(decoded);
+    if (snapshot['version'] != _snapshotVersion) {
+      throw const FormatException('Unsupported demo snapshot version.');
+    }
+
+    final initialBalance = _finiteDouble(snapshot['initialBalance'], 'initialBalance');
+    final balance = _finiteDouble(snapshot['balance'], 'balance');
+    final leverage = _finiteDouble(snapshot['leverage'], 'leverage');
+    final currency = '${snapshot['currency'] ?? ''}'.trim().toUpperCase();
+    final tick = snapshot['tick'];
+    if (initialBalance < 100 || initialBalance > 100000000) {
+      throw const FormatException('Invalid demo initial balance.');
+    }
+    if (balance < 0 || balance > 1000000000000) {
+      throw const FormatException('Invalid demo balance.');
+    }
+    if (leverage < 1 || leverage > 2000) {
+      throw const FormatException('Invalid demo leverage.');
+    }
+    if (!RegExp(r'^[A-Z]{3}$').hasMatch(currency)) {
+      throw const FormatException('Invalid demo currency.');
+    }
+    if (tick is! int || tick < 0 || tick > 1000000000) {
+      throw const FormatException('Invalid demo clock.');
+    }
+
+    final bots = _mapList(snapshot['bots'], 'bots', maximum: 100);
+    final openPositions = _mapList(snapshot['openPositions'], 'openPositions', maximum: 500);
+    final closedTrades = _mapList(snapshot['closedTrades'], 'closedTrades', maximum: 500);
+    final botIds = <String>{};
+    for (final bot in bots) {
+      final id = '${bot['id'] ?? ''}';
+      final state = '${bot['state'] ?? ''}';
+      if (id.isEmpty || !botIds.add(id) || !const {'running', 'paused', 'stopped'}.contains(state)) {
+        throw const FormatException('Invalid demo bot state.');
+      }
+      if ('${bot['symbol'] ?? ''}'.isEmpty || '${bot['environment'] ?? ''}' != 'paper') {
+        throw const FormatException('Invalid demo bot contract.');
+      }
+    }
+    for (final position in openPositions) {
+      final botId = '${position['bot_instance_id'] ?? ''}';
+      Map<String, dynamic>? owner;
+      for (final bot in bots) {
+        if ('${bot['id']}' == botId) {
+          owner = bot;
+          break;
+        }
+      }
+      if (owner == null || owner['state'] == 'stopped' || '${position['state']}' != 'OPEN') {
+        throw const FormatException('Invalid demo open position ownership.');
+      }
+      _finiteDouble(position['entry_price'], 'entry_price');
+      _finiteDouble(position['current_price'], 'current_price');
+      _finiteDouble(position['_risk_capital'], '_risk_capital');
+    }
+
+    final rawPrices = snapshot['prices'];
+    if (rawPrices is! Map || rawPrices.length > 500) {
+      throw const FormatException('Invalid demo prices.');
+    }
+    final prices = <String, double>{};
+    for (final entry in rawPrices.entries) {
+      final symbol = '${entry.key}'.trim().toUpperCase();
+      final value = _finiteDouble(entry.value, 'price');
+      if (symbol.isEmpty || value <= 0) throw const FormatException('Invalid demo price.');
+      prices[symbol] = value;
+    }
+
+    _initialBalance = initialBalance;
+    _balance = balance;
+    _currency = currency;
+    _leverage = leverage;
+    _tick = tick;
