+
+  test('local demo persists wallet bots positions and trade history across restart', () async {
+    SharedPreferences.setMockInitialValues(const {});
+    Map<String, dynamic> beforeRestart = const {};
+    final first = LocalDemoEngine(onChanged: (snapshot) => beforeRestart = snapshot);
+
+    await first.configure(amount: 50000, currency: 'USD', leverage: 200);
+    final ids = <String>[];
+    for (final bot in const [
+      ('AI_INSTITUTIONAL', 'AI Institutional'),
+      ('INSTITUTIONAL_HFT', 'Institutional HFT'),
+      ('DCA', 'DCA'),
+      ('GRID', 'Grid'),
+      ('CUSTOM', 'Create My Own Bot'),
+    ]) {
+      final started = first.startBot(botType: bot.$1, displayName: bot.$2, symbol: 'XAUUSD');
+      ids.add('${started['botInstanceId']}');
+    }
+    first.advanceForTest(240);
+    for (var index = 0; index < 30 && (beforeRestart['openOrders'] as List).isEmpty; index++) {
+      first.advanceForTest(1);
+    }
+    for (final id in ids) {
+      first.command(id, 'pause');
+    }
+    await first.flushForTest();
+
+    final expectedBalance = (beforeRestart['account'] as Map)['balance'];
+    final expectedOpenOrders = (beforeRestart['openOrders'] as List).length;
+    final expectedClosedOrders = (beforeRestart['closedOrders'] as List).length;
+    expect(expectedClosedOrders, greaterThan(0));
+    expect(expectedOpenOrders, greaterThan(0));
+    first.dispose();
+
+    Map<String, dynamic> restored = const {};
+    final second = LocalDemoEngine(onChanged: (snapshot) => restored = snapshot);
+    await second.restore();
+
+    expect((restored['account'] as Map)['balance'], expectedBalance);
+    expect((restored['bots'] as List), hasLength(5));
+    expect(
+      (restored['bots'] as List).cast<Map<String, dynamic>>().every((bot) => bot['state'] == 'paused'),
+      isTrue,
+    );
+    expect((restored['openOrders'] as List), hasLength(expectedOpenOrders));
+    expect((restored['closedOrders'] as List), hasLength(expectedClosedOrders));
+    expect(restored['practiceFeed'], isTrue);
+
+    second.command(ids.first, 'resume');
+    second.advanceForTest(30);
+    expect(
+      (restored['bots'] as List).cast<Map<String, dynamic>>().firstWhere((bot) => bot['id'] == ids.first)['state'],
+      'running',
+    );
+    await second.flushForTest();
+    second.dispose();
+  });
+
