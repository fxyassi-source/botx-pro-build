+    return value.map((item) {
+      if (item is! Map) throw FormatException('Invalid demo $name item.');
+      return Map<String, dynamic>.from(item);
+    }).toList();
+  }
+
+  double _finiteDouble(Object? value, String name) {
+    if (value is! num || !value.isFinite) throw FormatException('Invalid demo $name.');
+    return value.toDouble();
+  }
