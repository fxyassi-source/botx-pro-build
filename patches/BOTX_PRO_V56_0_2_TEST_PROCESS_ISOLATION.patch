+import 'package:botx_pro_v16/app/v16_app_controller.dart';
+import 'package:botx_pro_v16/app/v56_native_shell.dart';
+import 'package:botx_pro_v16/core/config/app_config.dart';
+import 'package:botx_pro_v16/core/theme/v56_theme.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+final demoFlowConfig = AppConfig(
+  apiBaseUrl: Uri(scheme: 'http', host: '127.0.0.1', port: 8080),
+  wsBaseUrl: Uri(
+    scheme: 'ws',
+    host: '127.0.0.1',
+    port: 8080,
+    path: '/realtime',
+  ),
+  environment: 'offline-demo',
+  commandTimeout: const Duration(seconds: 25),
+  backendConfigured: false,
+);
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  testWidgets('Guest V56 shell creates a demo account from a virtual balance', (
+    tester,
+  ) async {
+    SharedPreferences.setMockInitialValues(const {});
+    final controller = V16AppController(
+      config: demoFlowConfig,
+      guestMode: true,
+    );
+    final themes = V56ThemeController();
+    addTearDown(controller.dispose);
+    addTearDown(themes.dispose);
+
+    await tester.runAsync(() => controller.initialize());
+    expect(controller.localDemoActive, isFalse);
+
+    await tester.pumpWidget(
+      MaterialApp(
+        debugShowCheckedModeBanner: false,
+        theme: themes.theme,
+        home: V56NativeShell(
+          controller: controller,
+          themeController: themes,
+        ),
+      ),
+    );
+    await tester.pump();
+
+    final demoSetup = find.byKey(const ValueKey('v56_demo_setup'));
+    expect(demoSetup, findsOneWidget);
+    expect(find.text('Create Demo Account'), findsOneWidget);
+
+    final startDemo = find.byKey(const ValueKey('v56_start_demo_trading'));
+    expect(startDemo, findsOneWidget);
+    expect(tester.widget<FilledButton>(startDemo).onPressed, isNotNull);
+    expect(find.byKey(const ValueKey('v56_demo_amount')), findsOneWidget);
+    expect(find.textContaining('all five BotX bots'), findsOneWidget);
+  });
+}
