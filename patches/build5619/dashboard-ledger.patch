+  /// Portfolio headline activity comes from the same execution ledger shown
+  /// in Orders. Filled open positions use current P/L, completed trades use
+  /// realised P/L, and pending orders are deliberately excluded until filled.
+  V16Performance dashboardPerformanceFor(String period) {
+    final now = DateTime.now();
+    final cutoff = switch (period) {
+      '1D' => now.subtract(const Duration(days: 1)),
+      '1W' => now.subtract(const Duration(days: 7)),
+      '1M' => DateTime(now.year, now.month - 1, now.day, now.hour, now.minute),
+      '1Y' => DateTime(now.year - 1, now.month, now.day, now.hour, now.minute),
+      _ => now.subtract(const Duration(days: 7)),
+    };
+    final closed = allClosedTrades
+        .where((trade) =>
+            trade.closedAt != null && !trade.closedAt!.isBefore(cutoff))
+        .toList()
+      ..sort((a, b) => a.closedAt!.compareTo(b.closedAt!));
+    final active = openOrders.where((row) {
+      final openedAt = _asDateTime(row['opened_at'] ??
+          row['openedAt'] ??
+          row['open_time'] ??
+          row['time_open'] ??
+          row['created_at']);
+      return openedAt == null || !openedAt.isBefore(cutoff);
+    }).toList(growable: false);
+    return calculateDashboardPerformance(
+      closedTrades: closed,
+      openOrders: active,
+    );
+  }
+
+  /// Calculates live Portfolio counters without corrupting realised analytics.
+  /// Terminal states accidentally present in the open collection are ignored.
+  @visibleForTesting
+  static V16Performance calculateDashboardPerformance({
+    required List<V16Trade> closedTrades,
+    required List<Map<String, dynamic>> openOrders,
+  }) {
+    final realised = calculatePerformance(closedTrades);
+    var positive = realised.positive;
+    var negative = realised.negative;
+    var activeTrades = 0;
+
+    for (final row in openOrders) {
+      final state = '${row['state'] ?? row['status'] ?? 'OPEN'}'
+          .trim()
+          .toLowerCase();
+      if (const {
+        'closed',
+        'cancelled',
+        'canceled',
+        'rejected',
+        'expired',
+      }.contains(state)) {
+        continue;
+      }
+      activeTrades++;
+      final pnl = _asDouble(row['open_pnl'] ??
+          row['openPnl'] ??
+          row['unrealized_pnl'] ??
+          row['unrealizedPnl'] ??
+          row['floating_pnl'] ??
+          row['profit']);
+      if (pnl != null && pnl > 0) positive++;
+      if (pnl != null && pnl < 0) negative++;
+    }
+
+    final trades = closedTrades.length + activeTrades;
+    final decided = positive + negative;
+    return V16Performance(
+      trades: trades,
+      positive: positive,
+      negative: negative,
+      winRate: decided == 0 ? 0 : positive * 100 / decided,
+      realizedPnl: realised.realizedPnl,
+      curve: realised.curve,
+    );
+  }
+
