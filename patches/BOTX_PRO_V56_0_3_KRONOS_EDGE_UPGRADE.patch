+++ b/lib/core/models/kronos_models.dart
@@ -0,0 +1,306 @@
+class KronosForecastSummary {
+  const KronosForecastSummary({
+    required this.direction,
+    required this.bullishProbability,
+    required this.bearishProbability,
+    required this.neutralProbability,
+    required this.confidence,
+    required this.expectedReturnBps,
+    required this.expectedVolatilityBps,
+    required this.pathDispersionBps,
+    required this.uncertainty,
+    required this.expectedLow,
+    required this.expectedHigh,
+    required this.expectedClose,
+    required this.pathCount,
+  });
+
+  final String direction;
+  final double bullishProbability;
+  final double bearishProbability;
+  final double neutralProbability;
+  final double confidence;
+  final double expectedReturnBps;
+  final double expectedVolatilityBps;
+  final double pathDispersionBps;
+  final double uncertainty;
+  final double expectedLow;
+  final double expectedHigh;
+  final double expectedClose;
+  final int pathCount;
+
+  factory KronosForecastSummary.fromJson(Map<String, dynamic> json) {
+    final direction = '${json['direction'] ?? ''}'.trim().toLowerCase();
+    if (!const {'bullish', 'bearish', 'neutral', 'no_trade'}
+        .contains(direction)) {
+      throw FormatException(
+        'Kronos summary has an invalid direction: ${json['direction']}',
+      );
+    }
+    final bullishProbability = _requiredDouble(
+      json,
+      const ['bullish_probability', 'bullishProbability'],
+      min: 0,
+      max: 1,
+    );
+    final bearishProbability = _requiredDouble(
+      json,
+      const ['bearish_probability', 'bearishProbability'],
+      min: 0,
+      max: 1,
+    );
+    final neutralProbability = _requiredDouble(
+      json,
+      const ['neutral_probability', 'neutralProbability'],
+      min: 0,
+      max: 1,
+    );
+    final probabilityTotal =
+        bullishProbability + bearishProbability + neutralProbability;
+    if ((probabilityTotal - 1).abs() > 0.05) {
+      throw FormatException(
+        'Kronos direction probabilities must total approximately 1; '
+        'received $probabilityTotal',
+      );
+    }
+    final expectedLow = _requiredDouble(
+      json,
+      const ['expected_low', 'expectedLow'],
+      minExclusive: 0,
+    );
+    final expectedHigh = _requiredDouble(
+      json,
+      const ['expected_high', 'expectedHigh'],
+      minExclusive: 0,
+    );
+    final expectedClose = _requiredDouble(
+      json,
+      const ['expected_close', 'expectedClose'],
+      minExclusive: 0,
+    );
+    if (expectedLow > expectedHigh ||
+        expectedClose < expectedLow ||
+        expectedClose > expectedHigh) {
+      throw const FormatException(
+        'Kronos expected prices must satisfy low <= close <= high',
+      );
+    }
+    return KronosForecastSummary(
+      direction: direction,
+      bullishProbability: bullishProbability,
+      bearishProbability: bearishProbability,
+      neutralProbability: neutralProbability,
+      confidence: _requiredDouble(
+        json,
+        const ['confidence'],
+        min: 0,
+        max: 1,
+      ),
+      expectedReturnBps: _requiredDouble(
+        json,
+        const ['expected_return_bps', 'expectedReturnBps'],
+      ),
+      expectedVolatilityBps: _requiredDouble(
+        json,
+        const ['expected_volatility_bps', 'expectedVolatilityBps'],
+        min: 0,
+      ),
+      pathDispersionBps: _requiredDouble(
+        json,
+        const ['path_dispersion_bps', 'pathDispersionBps'],
+        min: 0,
+      ),
+      uncertainty: _requiredDouble(
+        json,
+        const ['uncertainty'],
+        min: 0,
+        max: 1,
+      ),
+      expectedLow: expectedLow,
+      expectedHigh: expectedHigh,
+      expectedClose: expectedClose,
+      pathCount: _requiredInt(
+        json,
+        const ['path_count', 'pathCount'],
+        min: 1,
+      ),
+    );
+  }
+
+  double get directionalProbability =>
+      bullishProbability >= bearishProbability ? bullishProbability : bearishProbability;
+}
+
+class KronosForecast {
+  const KronosForecast({
+    required this.requestId,
+    required this.model,
+    required this.tokenizer,
+    required this.sourceCommit,
+    required this.symbol,
+    required this.timeframe,
+    required this.generatedAt,
+    required this.expiresAt,
+    required this.inputCandleCount,
+    required this.horizon,
+    required this.summary,
+    required this.cached,
+  });
+
+  final String requestId;
+  final String model;
+  final String tokenizer;
+  final String sourceCommit;
+  final String symbol;
+  final String timeframe;
+  final DateTime? generatedAt;
+  final DateTime? expiresAt;
+  final int inputCandleCount;
+  final int horizon;
+  final KronosForecastSummary summary;
+  final bool cached;
+
+  bool get fresh {
+    final expiry = expiresAt;
+    return expiry != null && expiry.isAfter(DateTime.now().toUtc());
+  }
+
+  factory KronosForecast.fromJson(Map<String, dynamic> json) {
+    final summaryRaw = json['summary'];
+    if (summaryRaw is! Map) {
+      throw const FormatException('Kronos response is missing summary');
+    }
+    return KronosForecast(
+      requestId: '${json['request_id'] ?? json['requestId'] ?? ''}',
+      model: '${json['model'] ?? ''}',
+      tokenizer: '${json['tokenizer'] ?? ''}',
+      sourceCommit: '${json['source_commit'] ?? json['sourceCommit'] ?? ''}',
+      symbol: '${json['symbol'] ?? ''}'.toUpperCase(),
+      timeframe: '${json['timeframe'] ?? ''}',
+      generatedAt: _date(json['generated_at'] ?? json['generatedAt']),
+      expiresAt: _date(json['expires_at'] ?? json['expiresAt']),
+      inputCandleCount: _requiredInt(
+        json,
+        const ['input_candle_count', 'inputCandleCount'],
+        min: 1,
+        max: 512,
+      ),
+      horizon: _requiredInt(
+        json,
+        const ['horizon'],
+        min: 1,
+        max: 120,
+      ),
+      summary: KronosForecastSummary.fromJson(Map<String, dynamic>.from(summaryRaw)),
+      cached: json['cached'] == true,
+    );
+  }
+
+  Map<String, dynamic> toMarketSnapshotPatch() => {
+        'kronosForecast': {
+          'requestId': requestId,
+          'model': model,
+          'tokenizer': tokenizer,
+          'sourceCommit': sourceCommit,
+          'symbol': symbol,
+          'timeframe': timeframe,
+          'generatedAt': generatedAt?.toIso8601String(),
+          'expiresAt': expiresAt?.toIso8601String(),
+          'inputCandleCount': inputCandleCount,
+          'horizon': horizon,
+          'cached': cached,
+          'direction': summary.direction,
+          'bullishProbability': summary.bullishProbability,
+          'bearishProbability': summary.bearishProbability,
+          'neutralProbability': summary.neutralProbability,
+          'confidence': summary.confidence,
+          'expectedReturnBps': summary.expectedReturnBps,
+          'expectedVolatilityBps': summary.expectedVolatilityBps,
+          'pathDispersionBps': summary.pathDispersionBps,
+          'uncertainty': summary.uncertainty,
+          'expectedLow': summary.expectedLow,
+          'expectedHigh': summary.expectedHigh,
+          'expectedClose': summary.expectedClose,
+          'pathCount': summary.pathCount,
+        },
+        'kronosStatus': fresh ? 'fresh' : 'stale',
+      };
+}
+
+double _requiredDouble(
+  Map<String, dynamic> json,
+  List<String> keys, {
+  double? min,
+  double? max,
+  double? minExclusive,
+}) {
+  final entry = _requiredEntry(json, keys);
+  final value = entry.$2;
+  final parsed = value is num
+      ? value.toDouble()
+      : double.tryParse('$value'.trim());
+  if (parsed == null || !parsed.isFinite) {
+    throw FormatException(
+      'Kronos field ${entry.$1} must be a finite number',
+    );
+  }
+  if (min != null && parsed < min ||
+      max != null && parsed > max ||
+      minExclusive != null && parsed <= minExclusive) {
+    throw FormatException(
+      'Kronos field ${entry.$1} is outside its allowed range',
+    );
+  }
+  return parsed;
+}
+
+int _requiredInt(
+  Map<String, dynamic> json,
+  List<String> keys, {
+  int? min,
+  int? max,
+}) {
+  final entry = _requiredEntry(json, keys);
+  final value = entry.$2;
+  int? parsed;
+  if (value is int) {
+    parsed = value;
+  } else if (value is num &&
+      value.toDouble().isFinite &&
+      value.toDouble() == value.toDouble().truncateToDouble()) {
+    parsed = value.toInt();
+  } else {
+    parsed = int.tryParse('$value'.trim());
+  }
+  if (parsed == null) {
+    throw FormatException(
+      'Kronos field ${entry.$1} must be an integer',
+    );
+  }
+  if (min != null && parsed < min || max != null && parsed > max) {
+    throw FormatException(
+      'Kronos field ${entry.$1} is outside its allowed range',
+    );
+  }
+  return parsed;
+}
+
+(String, Object) _requiredEntry(
+  Map<String, dynamic> json,
+  List<String> keys,
+) {
+  for (final key in keys) {
+    final value = json[key];
+    if (json.containsKey(key) && value != null) {
+      return (key, value);
+    }
+  }
+  throw FormatException(
+    'Kronos response is missing required field ${keys.first}',
+  );
+}
+
+DateTime? _date(Object? value) {
+  if (value == null) return null;
+  return DateTime.tryParse('$value')?.toUtc();
+}
