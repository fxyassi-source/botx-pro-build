diff --git a/test/kronos_contract_test.dart b/test/kronos_contract_test.dart
new file mode 100644
index 0000000..0896ec4
--- /dev/null
+++ b/test/kronos_contract_test.dart
@@ -0,0 +1,51 @@
+import 'package:botx_pro_v16/core/models/kronos_models.dart';
+import 'package:botx_pro_v16/features/intelligence/kronos_controller.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('Kronos response parses the pinned forecast contract', () {
+    final forecast = KronosForecast.fromJson({
+      'request_id': 'req-1',
+      'model': 'NeoQuasar/Kronos-base',
+      'tokenizer': 'NeoQuasar/Kronos-Tokenizer-base',
+      'source_commit': '67b630e67f6a18c9e9be918d9b4337c960db1e9a',
+      'symbol': 'XAUUSD',
+      'timeframe': '1H',
+      'generated_at': '2026-07-29T00:00:00Z',
+      'expires_at': '2026-07-29T01:00:00Z',
+      'input_candle_count': 400,
+      'horizon': 12,
+      'cached': false,
+      'summary': {
+        'direction': 'bullish',
+        'bullish_probability': 0.72,
+        'bearish_probability': 0.20,
+        'neutral_probability': 0.08,
+        'confidence': 0.68,
+        'expected_return_bps': 18.0,
+        'expected_volatility_bps': 42.0,
+        'path_dispersion_bps': 12.0,
+        'uncertainty': 0.20,
+        'expected_low': 3320.0,
+        'expected_high': 3370.0,
+        'expected_close': 3350.0,
+        'path_count': 5,
+      },
+    });
+    expect(forecast.model, 'NeoQuasar/Kronos-base');
+    expect(forecast.summary.direction, 'bullish');
+    expect(forecast.summary.pathCount, 5);
+    expect(forecast.toMarketSnapshotPatch()['kronosForecast'], isA<Map>());
+  });
+
+  test('AI Institutional profile keeps Kronos a capped confirmation layer', () {
+    final profile = KronosIntelligenceController.aiInstitutionalProfile();
+    final providers = Map<String, dynamic>.from(profile['providers']! as Map);
+    final kronos = Map<String, dynamic>.from(providers['kronos']! as Map);
+    expect(kronos['role'], 'forecast_confirmation');
+    expect(kronos['initialWeight'], 0.20);
+    expect(kronos['hardWeightCap'], 0.25);
+    expect(profile['executionAuthority'], 'independent_institutional_risk_engine');
+    expect(profile['hotPathPolicy'], 'asynchronous_precomputed_only');
+  });
+}
