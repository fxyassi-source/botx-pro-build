@@ -0,0 +1,153 @@
+class KronosForecastSummary {
+  const KronosForecastSummary({
+    required this.direction,
+    required this.bullishProbability,
+    required this.bearishProbability,
+    required this.neutralProbability,
+    required this.confidence,
+    required this.expectedReturnBps,
+    required this.expectedVolatilityBps,
+    required this.pathDispersionBps,
+    required this.uncertainty,
+    required this.expectedLow,
+    required this.expectedHigh,
+    required this.expectedClose,
+    required this.pathCount,
+  });
+
+  final String direction;
+  final double bullishProbability;
+  final double bearishProbability;
+  final double neutralProbability;
+  final double confidence;
+  final double expectedReturnBps;
+  final double expectedVolatilityBps;
+  final double pathDispersionBps;
+  final double uncertainty;
+  final double expectedLow;
+  final double expectedHigh;
+  final double expectedClose;
+  final int pathCount;
+
+  factory KronosForecastSummary.fromJson(Map<String, dynamic> json) {
+    return KronosForecastSummary(
+      direction: '${json['direction'] ?? 'no_trade'}',
+      bullishProbability: _double(json['bullish_probability'] ?? json['bullishProbability']),
+      bearishProbability: _double(json['bearish_probability'] ?? json['bearishProbability']),
+      neutralProbability: _double(json['neutral_probability'] ?? json['neutralProbability']),
+      confidence: _double(json['confidence']),
+      expectedReturnBps: _double(json['expected_return_bps'] ?? json['expectedReturnBps']),
+      expectedVolatilityBps: _double(json['expected_volatility_bps'] ?? json['expectedVolatilityBps']),
+      pathDispersionBps: _double(json['path_dispersion_bps'] ?? json['pathDispersionBps']),
+      uncertainty: _double(json['uncertainty']),
+      expectedLow: _double(json['expected_low'] ?? json['expectedLow']),
+      expectedHigh: _double(json['expected_high'] ?? json['expectedHigh']),
+      expectedClose: _double(json['expected_close'] ?? json['expectedClose']),
+      pathCount: _integer(json['path_count'] ?? json['pathCount']),
+    );
+  }
+
+  double get directionalProbability =>
+      bullishProbability >= bearishProbability ? bullishProbability : bearishProbability;
+}
+
+class KronosForecast {
+  const KronosForecast({
+    required this.requestId,
+    required this.model,
+    required this.tokenizer,
+    required this.sourceCommit,
+    required this.symbol,
+    required this.timeframe,
+    required this.generatedAt,
+    required this.expiresAt,
+    required this.inputCandleCount,
+    required this.horizon,
+    required this.summary,
+    required this.cached,
+  });
+
+  final String requestId;
+  final String model;
+  final String tokenizer;
+  final String sourceCommit;
+  final String symbol;
+  final String timeframe;
+  final DateTime? generatedAt;
+  final DateTime? expiresAt;
+  final int inputCandleCount;
+  final int horizon;
+  final KronosForecastSummary summary;
+  final bool cached;
+
+  bool get fresh {
+    final expiry = expiresAt;
+    return expiry != null && expiry.isAfter(DateTime.now().toUtc());
+  }
+
+  factory KronosForecast.fromJson(Map<String, dynamic> json) {
+    final summaryRaw = json['summary'];
+    if (summaryRaw is! Map) {
+      throw const FormatException('Kronos response is missing summary');
+    }
+    return KronosForecast(
+      requestId: '${json['request_id'] ?? json['requestId'] ?? ''}',
+      model: '${json['model'] ?? ''}',
+      tokenizer: '${json['tokenizer'] ?? ''}',
+      sourceCommit: '${json['source_commit'] ?? json['sourceCommit'] ?? ''}',
+      symbol: '${json['symbol'] ?? ''}'.toUpperCase(),
+      timeframe: '${json['timeframe'] ?? ''}',
+      generatedAt: _date(json['generated_at'] ?? json['generatedAt']),
+      expiresAt: _date(json['expires_at'] ?? json['expiresAt']),
+      inputCandleCount: _integer(json['input_candle_count'] ?? json['inputCandleCount']),
+      horizon: _integer(json['horizon']),
+      summary: KronosForecastSummary.fromJson(Map<String, dynamic>.from(summaryRaw)),
+      cached: json['cached'] == true,
+    );
+  }
+
+  Map<String, dynamic> toMarketSnapshotPatch() => {
+        'kronosForecast': {
+          'requestId': requestId,
+          'model': model,
+          'tokenizer': tokenizer,
+          'sourceCommit': sourceCommit,
+          'symbol': symbol,
+          'timeframe': timeframe,
+          'generatedAt': generatedAt?.toIso8601String(),
+          'expiresAt': expiresAt?.toIso8601String(),
+          'inputCandleCount': inputCandleCount,
+          'horizon': horizon,
+          'cached': cached,
+          'direction': summary.direction,
+          'bullishProbability': summary.bullishProbability,
+          'bearishProbability': summary.bearishProbability,
+          'neutralProbability': summary.neutralProbability,
+          'confidence': summary.confidence,
+          'expectedReturnBps': summary.expectedReturnBps,
+          'expectedVolatilityBps': summary.expectedVolatilityBps,
+          'pathDispersionBps': summary.pathDispersionBps,
+          'uncertainty': summary.uncertainty,
+          'expectedLow': summary.expectedLow,
+          'expectedHigh': summary.expectedHigh,
+          'expectedClose': summary.expectedClose,
+          'pathCount': summary.pathCount,
+        },
+        'kronosStatus': fresh ? 'fresh' : 'stale',
+      };
+}
+
+double _double(Object? value) {
+  if (value is num) return value.toDouble();
+  return double.tryParse('$value') ?? 0;
+}
+
+int _integer(Object? value) {
+  if (value is num) return value.toInt();
+  return int.tryParse('$value') ?? 0;
+}
+
+DateTime? _date(Object? value) {
+  if (value == null) return null;
+  return DateTime.tryParse('$value')?.toUtc();
+}
diff --git a/lib/features/intelligence/kronos_controller.dart b/lib/features/intelligence/kronos_controller.dart
new file mode 100644
index 0000000..8c564e8
--- /dev/null
+++ b/lib/features/intelligence/kronos_controller.dart
@@ -0,0 +1,164 @@
+import '../../core/models/kronos_models.dart';
+import '../../core/network/api_client.dart';
+
+class KronosIntelligenceController {
+  KronosIntelligenceController(this.api);
+
+  final ApiClient api;
+
+  static const int minimumCandles = 64;
+  static const int defaultLookback = 400;
+  static const int maximumContext = 512;
+
+  Future<KronosForecast> forecast({
+    required String symbol,
+    required String timeframe,
+    required List<Map<String, dynamic>> candles,
+    String? accountId,
+    int horizon = 12,
+    int sampleCount = 5,
+    bool includePath = false,
+  }) async {
+    final clean = _normalizedCandles(candles);
+    if (clean.length < minimumCandles) {
+      throw ApiException(
+        'At least $minimumCandles verified candles are required for Kronos forecasting.',
+        code: 'KRONOS_HISTORY_INSUFFICIENT',
+      );
+    }
+    final selected = clean.length > defaultLookback
+        ? clean.sublist(clean.length - defaultLookback)
+        : clean;
+    final result = await api.postJson(
+      '/v1/intelligence/kronos/forecast',
+      {
+        'symbol': symbol.toUpperCase(),
+        'timeframe': _serviceTimeframe(timeframe),
+        if (accountId != null && accountId.isNotEmpty) 'accountId': accountId,
+        'candles': selected,
+        'horizon': horizon.clamp(1, 120),
+        'sample_count': sampleCount.clamp(1, 9),
+        'temperature': 1.0,
+        'top_p': 0.90,
+        'top_k': 0,
+        'include_path': includePath,
+      },
+      idempotencyKey:
+          'kronos-${accountId ?? 'context'}-${symbol.toUpperCase()}-${_serviceTimeframe(timeframe)}-${selected.last['timestamp']}',
+    );
+    try {
+      return KronosForecast.fromJson(result);
+    } on FormatException catch (error) {
+      throw ApiException(
+        'Kronos service returned an invalid forecast contract.',
+        code: 'KRONOS_RESPONSE_INVALID',
+        details: error.message,
+      );
+    }
+  }
+
+  static Map<String, dynamic> aiInstitutionalProfile() => const {
+        'profileId': 'botx-ensemble-kronos-v1',
+        'decisionMode': 'calibrated_multi_model_ensemble',
+        'executionAuthority': 'independent_institutional_risk_engine',
+        'hotPathPolicy': 'asynchronous_precomputed_only',
+        'noTradeOnConflict': true,
+        'providers': {
+          'botxProprietaryMl': {
+            'role': 'primary',
+            'initialWeight': 0.40,
+          },
+          'kronos': {
+            'enabled': true,
+            'role': 'forecast_confirmation',
+            'model': 'NeoQuasar/Kronos-base',
+            'tokenizer': 'NeoQuasar/Kronos-Tokenizer-base',
+            'initialWeight': 0.20,
+            'hardWeightCap': 0.25,
+            'lookbackCandles': 400,
+            'maxContext': 512,
+            'sampleCount': 5,
+            'outputs': [
+              'direction_probability',
+              'expected_return_bps',
+              'expected_range',
+              'forecast_volatility_bps',
+              'uncertainty',
+            ],
+          },
+          'regimeClassifier': {'role': 'regime', 'initialWeight': 0.15},
+          'patternIntelligence': {'role': 'pattern', 'initialWeight': 0.10},
+          'newsSentiment': {'role': 'news', 'initialWeight': 0.10},
+          'portfolioCorrelation': {'role': 'portfolio', 'initialWeight': 0.05},
+        },
+        'gates': {
+          'minimumCalibratedConfidence': 0.62,
+          'minimumModelAgreement': 0.58,
+          'freshPriceRequired': true,
+          'sessionHealthRequired': true,
+          'spreadGateRequired': true,
+          'slippageGateRequired': true,
+          'killSwitchClearRequired': true,
+        },
+      };
+
+  static List<Map<String, dynamic>> _normalizedCandles(
+    List<Map<String, dynamic>> candles,
+  ) {
+    final result = <Map<String, dynamic>>[];
+    for (final candle in candles) {
+      final timestamp = '${candle['timestamp'] ?? candle['ts'] ?? ''}'.trim();
+      final open = _number(candle['open']);
+      final high = _number(candle['high']);
+      final low = _number(candle['low']);
+      final close = _number(candle['close']);
+      final volume = _number(candle['volume']) ?? 0.0;
+      if (timestamp.isEmpty ||
+          DateTime.tryParse(timestamp) == null ||
+          open == null ||
+          high == null ||
+          low == null ||
+          close == null ||
+          open <= 0 ||
+          high < open ||
+          high < close ||
+          high < low ||
+          low > open ||
+          low > close ||
+          volume < 0) {
+        continue;
+      }
+      final amount = _number(candle['amount']);
+      result.add({
+        'timestamp': DateTime.parse(timestamp).toUtc().toIso8601String(),
+        'open': open,
+        'high': high,
+        'low': low,
+        'close': close,
+        'volume': volume,
+        if (amount != null) 'amount': amount,
+      });
+    }
+    result.sort((a, b) => '${a['timestamp']}'.compareTo('${b['timestamp']}'));
+    if (result.length > maximumContext) {
+      return result.sublist(result.length - maximumContext);
+    }
+    return result;
+  }
+
+  static String _serviceTimeframe(String timeframe) => switch (timeframe) {
+        '1m' => '1m',
+        '5m' => '5m',
+        '15m' => '15m',
+        '30m' => '30m',
+        '1H' => '1H',
+        '4H' => '4H',
+        '1D' || '1W' || '1M' || '3M' || '1Y' => '1D',
+        _ => '1H',
+      };
+}
+
+double? _number(Object? value) {
+  if (value is num) return value.toDouble();
+  return double.tryParse('$value'.replaceAll(',', '').trim());
+}
