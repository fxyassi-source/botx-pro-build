+  final ApiClient api;
+
+  static const int minimumCandles = 64;
+  static const int defaultLookback = 400;
+  static const int maximumContext = 512;
+
+  Future<KronosForecast> forecast({
+    required String symbol,
+    required String timeframe,
+    required List<Map<String, dynamic>> candles,
+    String? accountId,
+    int horizon = 12,
+    int sampleCount = 5,
+    bool includePath = false,
+  }) async {
+    final clean = _normalizedCandles(candles);
+    if (clean.length < minimumCandles) {
+      throw ApiException(
+        'At least $minimumCandles verified candles are required for Kronos forecasting.',
+        code: 'KRONOS_HISTORY_INSUFFICIENT',
+      );
+    }
+    final selected = clean.length > defaultLookback
+        ? clean.sublist(clean.length - defaultLookback)
+        : clean;
+    final result = await api.postJson(
+      '/v1/intelligence/kronos/forecast',
+      {
+        'symbol': symbol.toUpperCase(),
+        'timeframe': _serviceTimeframe(timeframe),
+        if (accountId != null && accountId.isNotEmpty) 'accountId': accountId,
+        'candles': selected,
+        'horizon': horizon.clamp(1, 120),
+        'sample_count': sampleCount.clamp(1, 9),
+        'temperature': 1.0,
+        'top_p': 0.90,
+        'top_k': 0,
+        'include_path': includePath,
+      },
+      idempotencyKey:
+          'kronos-${accountId ?? 'context'}-${symbol.toUpperCase()}-${_serviceTimeframe(timeframe)}-${selected.last['timestamp']}',
+    );
+    try {
+      return KronosForecast.fromJson(result);
+    } on FormatException catch (error) {
+      throw ApiException(
+        'Kronos service returned an invalid forecast contract.',
+        code: 'KRONOS_RESPONSE_INVALID',
+        details: error.message,
+      );
+    }
+  }
+
+  static Map<String, dynamic> aiInstitutionalProfile() => const {
+        'profileId': 'botx-ensemble-kronos-v1',
+        'decisionMode': 'calibrated_multi_model_ensemble',
+        'executionAuthority': 'independent_institutional_risk_engine',
+        'hotPathPolicy': 'asynchronous_precomputed_only',
+        'noTradeOnConflict': true,
+        'providers': {
+          'botxProprietaryMl': {
+            'role': 'primary',
+            'initialWeight': 0.40,
+          },
+          'kronos': {
+            'enabled': true,
+            'role': 'forecast_confirmation',
+            'model': 'NeoQuasar/Kronos-base',
+            'tokenizer': 'NeoQuasar/Kronos-Tokenizer-base',
+            'initialWeight': 0.20,
+            'hardWeightCap': 0.25,
+            'lookbackCandles': 400,
+            'maxContext': 512,
+            'sampleCount': 5,
+            'outputs': [
+              'direction_probability',
+              'expected_return_bps',
+              'expected_range',
+              'forecast_volatility_bps',
+              'uncertainty',
+            ],
+          },
+          'regimeClassifier': {'role': 'regime', 'initialWeight': 0.15},
+          'patternIntelligence': {'role': 'pattern', 'initialWeight': 0.10},
+          'newsSentiment': {'role': 'news', 'initialWeight': 0.10},
+          'portfolioCorrelation': {'role': 'portfolio', 'initialWeight': 0.05},
+        },
+        'gates': {
+          'minimumCalibratedConfidence': 0.62,
+          'minimumModelAgreement': 0.58,
+          'freshPriceRequired': true,
+          'sessionHealthRequired': true,
+          'spreadGateRequired': true,
+          'slippageGateRequired': true,
+          'killSwitchClearRequired': true,
+        },
+      };
+
+  static List<Map<String, dynamic>> _normalizedCandles(
+    List<Map<String, dynamic>> candles,
+  ) {
+    final result = <Map<String, dynamic>>[];
+    for (final candle in candles) {
+      final timestamp = '${candle['timestamp'] ?? candle['ts'] ?? ''}'.trim();
+      final open = _number(candle['open']);
+      final high = _number(candle['high']);
+      final low = _number(candle['low']);
+      final close = _number(candle['close']);
+      final volume = _number(candle['volume']) ?? 0.0;
+      if (timestamp.isEmpty ||
+          DateTime.tryParse(timestamp) == null ||
+          open == null ||
+          high == null ||
+          low == null ||
+          close == null ||
+          open <= 0 ||
+          high < open ||
+          high < close ||
+          high < low ||
+          low > open ||
+          low > close ||
+          volume < 0) {
+        continue;
+      }
+      final amount = _number(candle['amount']);
+      result.add({
+        'timestamp': DateTime.parse(timestamp).toUtc().toIso8601String(),
+        'open': open,
+        'high': high,
+        'low': low,
+        'close': close,
+        'volume': volume,
+        if (amount != null) 'amount': amount,
+      });
+    }
+    result.sort((a, b) => '${a['timestamp']}'.compareTo('${b['timestamp']}'));
+    if (result.length > maximumContext) {
+      return result.sublist(result.length - maximumContext);
+    }
+    return result;
+  }
+
+  static String _serviceTimeframe(String timeframe) => switch (timeframe) {
+        '1m' => '1m',
+        '5m' => '5m',
+        '15m' => '15m',
+        '30m' => '30m',
+        '1H' => '1H',
+        '4H' => '4H',
+        '1D' || '1W' || '1M' || '3M' || '1Y' => '1D',
+        _ => '1H',
+      };
+}
+
+double? _number(Object? value) {
+  if (value is num) return value.toDouble();
+  return double.tryParse('$value'.replaceAll(',', '').trim());
+}
